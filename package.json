{
  "name": "rc-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local CLI that drives a headless Claude Agent SDK session and relays it to a phone through the claude-remote-control relay.",
  "bin": {
    "rc-agent": "dist/index.js"
  },
  "files": [
    "dist/",
    "connector.config.example.json"
  ],
  "scripts": {
    "build": "node build.mjs",
    "start": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:contract": "node --import tsx --test test/contract/*.contract.ts",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@github/copilot-sdk": "1.0.14",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
